# ============================================================
#  Configurações do sistema — copie para .env e preencha
# ============================================================

# Segurança (gere uma chave em: https://djecrety.ir)
SECRET_KEY=coloque-sua-chave-secreta-aqui
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=pdv_artigos
DB_USER=pdv_user
DB_PASSWORD=coloque-sua-senha-aqui
DB_HOST=127.0.0.1
DB_PORT=3306

# JWT
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7

# Frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fidelidade
PONTOS_POR_REAL=1
MINIMO_RESGATE_PONTOS=100
COMPRAS_PARA_VOUCHER=10
VALOR_VOUCHER=50

# Logs
LOG_LEVEL=ERROR