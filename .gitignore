# ---- Segredos — NUNCA subir ----
backend/.env
.env
*.env

# ---- Node / React ----
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# ---- IDEs ----
.vscode/
.idea/
*.swp
*.swo

# ---- Sistema Operacional ----
.DS_Store
Thumbs.db
desktop.ini